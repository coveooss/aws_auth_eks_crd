{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": [
    "github>coveooss/renovate-presets",
    "helpers:pinGitHubActionDigests",
    "schedule:earlyMondays",
    "group:allNonMajor",
    "github>coveooss/renovate-presets//poetry-version.json"
  ],
  "labels": [
    "dependency update",
    "bot"
  ],
  "prHeader": "DEF-160",
  "suppressNotifications": [
    "prIgnoreNotification"
  ],
  "timezone": "America/Toronto",
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^kubernetes/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:ARG\\s+)?[A-Z_]+[:=]\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "poetry",
        "poetry-plugin-export"
      ],
      "groupName": "poetry"
    }
  ]
}
